PORT=3000
# Stringa di connessione di MongoDB Atlas
MONGO_URI=mongodb+srv://UTENTE:PASSWORD@CLUSTER.mongodb.net/taskmanager?retryWrites=true&w=majority
# Segreto per firmare i JWT: sostituire con una stringa lunga e casuale
JWT_SECRET=stringa-lunga-e-casuale
JWT_EXPIRES_IN=8h
# Registrazione consentita solo con email di questo dominio (vuoto = chiunque)
ALLOWED_EMAIL_DOMAIN=azienda.it
